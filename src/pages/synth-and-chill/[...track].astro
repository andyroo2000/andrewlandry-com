---
import ArrowUpRight from '../../components/ArrowUpRight.astro';
import ThemeHead from '../../components/ThemeHead.astro';

import tracks from '../../data/synth-tracks.json';
import { synthTrackPageTitle } from '../../scripts/synth-track-links';
import { muxPlaybackId } from '../../data/mux-videos';

export function getStaticPaths() {
  return [
    { params: { track: undefined }, props: {} },
    ...tracks.map(track => ({ params: { track: track.slug }, props: { track } })),
  ];
}
interface Props { track?: (typeof tracks)[number] }
const { track } = Astro.props;
const selected = track ?? tracks[0]!;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeHead dark />
    <meta name="description" content="Synthesizer sessions from Andrew Landry’s basement." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{synthTrackPageTitle(track?.title)}</title>
  </head>
  <body>
    <canvas class="atmosphere" data-synth-canvas aria-hidden="true"></canvas>
    <div class="terrain-softness" data-terrain-softness aria-hidden="true" hidden></div>
    <div class="paper-grain" aria-hidden="true"></div>
    <div class="room" data-synth-room>
      <header class="masthead">
        <a class="home" href="/" aria-label="Andrew Landry home">AL<span aria-hidden="true"><ArrowUpRight /></span></a>
        <span class="edition">Andrew Landry <span aria-hidden="true">/</span> Basement sessions</span>
        <div class="room-actions" role="group" aria-label="Room settings">
          <button class="room-action" data-change-visualization>
            <svg class="change-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h15m-4-4 4 4-4 4M20 16H5m4-4-4 4 4 4" /></svg>
            Change visualization
          </button>
        </div>
      </header>

      <main id="main" class="listening-room">
        <div class="identity">
          <h1>synth<br /><span>&amp; chill.</span></h1>
          <button class="start-listening" data-listen aria-keyshortcuts="Space" title="Play or pause (Space)" disabled><span data-listen-icon aria-hidden="true">▶</span><span data-listen-label>Start listening</span></button>
          <p class="player-message" data-player-message role="status" hidden></p>
        </div>

        <section class="film" aria-label="Synth and chill playlist">
          <mux-player
            id="synth-mux"
            class="session-video"
            playback-id={muxPlaybackId(selected.videoId)}
            stream-type="on-demand"
            preload="metadata"
            max-resolution="1080p"
            accent-color="#f2f76c"
            aria-label={selected.title}
          ></mux-player>
          <div class="film-caption" role="group" aria-label="Playback controls">
            <button class="track-button" data-previous-track aria-label="Previous track" aria-keyshortcuts="ArrowLeft" title="Previous track (←)" disabled><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 6-6 6 6 6" /></svg> Previous track</button>
            <span class="track-title" data-track-title aria-live="polite">{track?.title ?? 'Synth & chill'}</span>
            <button class="track-button" data-next-track aria-label="Next track" aria-keyshortcuts="ArrowRight" title="Next track (→)" disabled>Next track <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 6 6 6-6 6" /></svg></button>
          </div>
        </section>
      </main>

    </div>
    <script>
      import { initSynthVisuals } from '../../scripts/synth-visuals';
      import { initSynthPlayer } from '../../scripts/synth-player';
      const readPlayback = initSynthPlayer();
      initSynthVisuals(readPlayback);
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { --blue: var(--site-bg); --lemon: #f2f76c; --ink: var(--site-ink); --paper: #fffef6; margin: 0; background: var(--blue); color: var(--paper); font-family: 'Space Grotesk', sans-serif; transition: background-color .7s; }
  button, a { -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
  button { font: inherit; }
  button { cursor: pointer; }
  button, a { color: inherit; }
  button { border: 0; }
  a { text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 5px; }
  :is(button, a):focus-visible { outline: 3px solid var(--lemon); outline-offset: 5px; }
  .atmosphere { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .terrain-softness {
    position: fixed; inset: 0; pointer-events: none;
    -webkit-backdrop-filter: blur(var(--terrain-blur, 0px));
    backdrop-filter: blur(var(--terrain-blur, 0px));
    -webkit-mask-image: var(--terrain-softness-mask);
    mask-image: var(--terrain-softness-mask);
  }
  .paper-grain { position: fixed; inset: 0; pointer-events: none; opacity: .17; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Cpath fill='%23fff' filter='url(%23n)' opacity='.35' d='M0 0h180v180H0z'/%3E%3C/svg%3E"); }
  .room { position: relative; min-height: 100svh; display: flex; flex-direction: column; padding: 30px 4vw 32px; }
  .masthead { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 25px; }
  .home { font-size: 24px; font-weight: 700; letter-spacing: -.08em; display: inline-flex; align-items: center; gap: 15px; min-height: 44px; }
  .home span { font-size: 36px; font-weight: 400; }
  .edition { font-size: 12px; letter-spacing: .04em; margin-right: auto; margin-left: 30px; }
  .edition span { opacity: .55; margin: 0 14px; }
  .room-actions { display: flex; align-items: center; gap: 18px; margin-left: auto; }
  .room-action { display: inline-flex; align-items: center; gap: 10px; background: transparent; font-size: 13px; min-height: 44px; padding: 0 4px; white-space: nowrap; }
  .room-action:hover { color: var(--lemon); }
  .change-icon { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .listening-room { flex: 1; display: grid; grid-template-columns: .85fr 1.9fr; align-items: center; gap: 6.5vw; padding: 65px 0 70px; }
  .identity { padding-bottom: 10px; }
  h1 { margin: 0; font-size: clamp(62px, 8.1vw, 148px); font-weight: 500; letter-spacing: -.065em; line-height: .95; }
  h1 span { color: var(--lemon); white-space: nowrap; }
  .start-listening { margin-top: 38px; display: inline-flex; align-items: center; gap: 18px; min-height: 58px; padding: 15px 23px; background: var(--lemon); color: #101835; font-size: 17px; font-weight: 500; box-shadow: 5px 5px 0 #fffef624; }
  .start-listening:hover { background: var(--paper); }
  .start-listening:disabled { cursor: wait; opacity: .65; }
  .start-listening>span:first-child { font-size: 14px; width: 16px; }
  .player-message { max-width: 290px; font-size: 12px; line-height: 1.5; }
  .film { background: var(--site-card); color: var(--ink); padding: 9px 9px 0; box-shadow: 10px 12px 0 var(--site-shadow); min-width: 0; transform: rotate(-1deg); }
  :global(.session-video) { display: block; width: 100%; aspect-ratio: 16 / 9; min-height: 200px; border: 0; background: #0b1020; }
  mux-player { --seek-backward-button: none; --seek-forward-button: none; --playback-rate-button: none; --time-display: none; --duration-display: none; }
  mux-player::part(center play button) { --media-control-background: var(--blue); --media-control-hover-background: var(--lemon); --media-icon-color: var(--lemon); stroke: none; }
  mux-player::part(button):hover { --media-control-hover-background: var(--lemon); --media-icon-color: var(--blue); color: var(--blue); }
  .film-caption { display: grid; grid-template-columns: auto minmax(0,1fr) auto; align-items: center; padding: 9px 5px; gap: 10px; }
  .film-caption button:focus-visible { outline: 3px solid var(--ink); outline-offset: -3px; }
  .track-title { text-align: center; font-size: 16px; font-weight: 500; line-height: 1.3; overflow-wrap: anywhere; }
  .track-button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 4px 16px; background: transparent; font-size: 12px; line-height: 1.2; white-space: nowrap; }
  .track-button svg { display: block; flex: 0 0 18px; width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .track-button:hover:not(:disabled) { background: var(--lemon); color: #101835; }
  .track-button:disabled { opacity: .25; cursor: default; }
  @media (min-width: 1700px) { .room { padding-inline: 5vw; } .listening-room { gap: 6vw; } }
  @media (max-width: 1100px) {
    .room { padding: 22px 4vw 25px; }
    .listening-room { gap: 4vw; grid-template-columns: .8fr 1.8fr; }
    .edition { margin-left: 10px; }
    .room-actions { gap: 12px; }
  }
  @media (max-width: 760px) {
    .room { padding: 16px 22px 28px; }
    .edition { display: none; }
    .masthead { gap: 8px; }
    .room-actions { gap: 6px; }
    .room-action { gap: 6px; font-size: 11px; padding: 0; }
    .change-icon { width: 16px; height: 16px; }
    .listening-room { display: flex; flex-direction: column; align-items: stretch; gap: 35px; padding: 42px 0 36px; }
    .identity { position: relative; }
    h1 { font-size: clamp(66px, 14vw, 102px); }
    h1 br { display: none; }
    h1 span { margin-left: .15em; }
    .start-listening { margin-top: 24px; min-height: 52px; font-size: 15px; }
    .film { padding: 6px 6px 0; transform: rotate(-1deg); }
    .film-caption { grid-template-columns: 1fr 1fr; padding: 6px 0; gap: 2px 4px; }
    .track-title { grid-area: 1 / 1 / 2 / -1; font-size: 14px; padding: 8px; }
    .track-button { grid-row: 2; justify-self: start; }
    .track-button[data-next-track] { justify-self: end; }
  }
  @media (max-width: 390px) { .room { padding-inline: 14px; } h1 { font-size: 61px; } .film-caption { gap: 8px; font-size: 10px; } }
  @media (prefers-reduced-motion: reduce) { :global(body) { transition: none; } }
</style>
