---
import ArrowUpRight from '../components/ArrowUpRight.astro';
import ThemeHead from '../components/ThemeHead.astro';

const skills = [
  { name: 'Languages', detail: 'JavaScript · Python · PHP' },
  { name: 'Web development', detail: 'Node.js · Express · Vue' },
  { name: 'API development', detail: 'Backend services and client integrations' },
  { name: 'Data & search', detail: 'Elasticsearch · MySQL · Neo4j' },
  { name: 'Delivery & tooling', detail: 'Fastly · AI agentic workflows and tooling' },
  { name: 'Problem solving', detail: 'Debugging, performance, and system design' },
  { name: 'Collaboration', detail: 'Coordinating backend and frontend work' },
  { name: 'Project delivery', detail: 'Planning dependencies and meeting deadlines' },
];
const projects = [
  {
    id: 'convolab', number: '01', title: 'ConvoLab', category: 'Product & API engineering',
    date: '2026 · Ongoing', role: 'Personal project · Product design and development',
    image: '/eportfolio/convolab.jpg',
    alt: 'ConvoLab’s public Japanese date practice tool, with an answer reveal and calendar.',
    caption: 'A public practice tool from the wider ConvoLab learning product.',
    purpose: 'I built ConvoLab around a practical problem in my own language study: turning learning material into regular, usable practice. It brings together flashcard review, audio, and focused exercises, with public practice tools and a native iOS client.',
    approach: 'My work spans the product experience, backend APIs, and client behavior. The iOS client stores study data locally and queues review events for synchronization. Stable event identifiers let the server recognize a retried review instead of recording it twice.',
    evidence: 'The public date trainer offers a small, immediately usable example of the product. The native client’s source and architecture notes show how offline study, media preparation, and synchronization fit together.',
    reflection: 'This project connects API design with the experience of the person using it. A review can look complete on a device while still waiting to reach the server; handling that gap makes reliability part of the product design.',
    demonstrated: 'API development · Systems thinking · Product design',
    links: [
      { label: 'Try the public tool', href: 'https://convo-lab.com/tools/japanese-date' },
      { label: 'Explore the iOS source', href: 'https://github.com/andyroo2000/convo-lab-ios' },
    ],
  },
  {
    id: 'japan-cycling', number: '02', title: 'Japan Cycling Trips', category: 'Data visualization & storytelling',
    date: 'September 2026 · Trips recorded in 2025 & 2026',
    role: 'Personal project · Film, data preparation, and web development',
    image: '/eportfolio/japan-cycling.jpg',
    alt: 'Japan Cycling Trips showing a Hokkaido trip film alongside its synchronized route map.',
    caption: 'The desktop map connects a moment in the film to its place in the journey.',
    purpose: 'I created this interactive collection to give my cycling films a sense of place. Instead of asking viewers to infer the route from individual clips, I paired the films with a map that follows the journey as the video plays.',
    approach: 'I combined 34 Strava GPX recordings with photo and video timestamps, then mapped the media onto an ordered route. I kept cycling separate from transport legs and preserved the distinction between recorded locations and illustrative travel paths.',
    evidence: 'The two trips contain 250 story items. On desktop, playback and seeking update the route, location, and map position together. The implementation uses cached map tiles and a separate label layer to keep complex geography from being redrawn on every frame.',
    reflection: 'This is where my interest in data analytics meets interface design. The useful result is not simply a plotted line: it is a sequence that makes sense to a viewer while staying honest about the source data and its gaps.',
    demonstrated: 'Data integration · Geospatial visualization · Performance',
    links: [
      { label: 'Explore the trips', href: '/japan-cycling-trips/' },
      { label: 'Read the data sources', href: '/data/japan-map-SOURCES.txt' },
    ],
  },
  {
    id: 'synth-and-chill', number: '03', title: 'Synth & Chill', category: 'Audio analysis & creative engineering',
    date: 'September 2026', role: 'Personal project · Music, visual design, and development',
    image: '/eportfolio/synth-and-chill.jpg',
    alt: 'Synth & Chill with a synthesizer performance, playback controls, and a terrain visualization.',
    caption: 'A listening room for my synthesizer sessions, with music-responsive visuals.',
    purpose: 'I built Synth & Chill to turn my recorded synthesizer sessions into a more immersive listening experience. It brings my music background together with software engineering through two visualizations: Terrain and Rain.',
    approach: 'I used Python audio analysis to prepare volume and frequency-band measurements, then connected those measurements to browser visuals driven by the player’s clock. Pausing, seeking, and changing tracks keep the visuals aligned with the current recording.',
    evidence: 'Visitors can play the sessions and switch between the two visualizations. The player has keyboard controls, pauses background drawing in hidden tabs, and respects reduced-motion preferences. When analysis is unavailable, it uses ambient motion rather than another track’s data.',
    reflection: 'The project shows how analysis can support a creative experience. Timing, rendering cost, and accessible controls all affect whether the visuals complement the music. It also gives me a practical way to combine artistic judgment with measurable playback behavior.',
    demonstrated: 'Python · Audio analysis · Accessible interaction design',
    links: [
      { label: 'Enter the listening room', href: '/synth-and-chill/' },
      { label: 'Read the analysis notes', href: 'https://github.com/andyroo2000/andrewlandry-com/blob/main/public/data/synth-audio/SOURCES.md' },
    ],
  },
];
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeHead />
    <meta name="robots" content="noindex, noimageindex" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content="Andrew Landry’s professional ePortfolio: software engineering, data analytics, and three selected personal projects." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>Andrew Landry — ePortfolio</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead wrap">
      <a class="monogram" href="/" aria-label="Andrew Landry home">AL <ArrowUpRight /></a>
      <span class="edition">Professional ePortfolio / 2026</span>
      <nav aria-label="Portfolio sections">
        <a href="#work">Selected work</a>
        <a href="#experience">Experience</a>
        <a href="#education">Education &amp; skills</a>
      </nav>
    </header>
    <main id="main">
      <section class="intro wrap" aria-labelledby="name">
        <div class="intro-copy">
          <p class="eyebrow">Software engineering / Data analytics</p>
          <h1 id="name">Andrew <span>Landry</span></h1>
          <p class="role">Software Engineer at Adobe <span aria-hidden="true">·</span> Durham, NC</p>
          <div class="about" aria-label="About me">
            <p>I’m a software engineer at Adobe, where I’ve worked on Behance and now Firefly. I build backend services and web experiences, connect systems through APIs, and work with frontend engineers to turn complex requirements into features people can use.</p>
            <p>I’m also completing a Bachelor of Applied Arts and Sciences at the University of North Texas, with a concentration in Data Analytics. I want to keep growing in systems architecture and data-driven application development. My personal projects give me room to explore those interests through language learning, cycling, and music.</p>
          </div>
          <a class="text-link intro-link" href="#work">Explore my work <span aria-hidden="true">↓</span></a>
        </div>
        <figure class="portrait">
          <img src="/eportfolio/andrew-landry.png" width="800" height="800" alt="Andrew Landry, wearing glasses against a gray background." fetchpriority="high" />
          <figcaption>Engineer. Maker. Lifelong learner.</figcaption>
        </figure>
      </section>

      <section id="work" class="work" aria-labelledby="work-title">
        <div class="wrap">
          <header class="section-heading">
            <div><p class="eyebrow">Three projects / Three ways of thinking</p><h2 id="work-title">Selected work<span>.</span></h2></div>
            <p>Useful products, meaningful data,<br />and room to experiment.</p>
          </header>
          <nav class="project-index" aria-label="Selected projects">
            {projects.map(project => <a href={`#${project.id}`}><span>{project.number}</span>{project.title}<span aria-hidden="true">↓</span></a>)}
          </nav>
          {projects.map(project => (
            <article class="project" id={project.id} aria-labelledby={`${project.id}-title`}>
              <header class="project-heading">
                <span class="project-number" aria-hidden="true">{project.number}</span>
                <div><p class="eyebrow">{project.category}</p><h3 id={`${project.id}-title`}>{project.title}</h3></div>
              </header>
              <div class="project-grid">
                <div class="project-media">
                  <figure>
                    <a href={project.links[0].href} aria-label={`Explore ${project.title}`}><img src={project.image} width="1710" height="896" loading="lazy" alt={project.alt} /></a>
                    <figcaption>{project.caption}</figcaption>
                  </figure>
                  <dl class="project-meta"><div><dt>When</dt><dd>{project.date}</dd></div><div><dt>My role</dt><dd>{project.role}</dd></div></dl>
                  <p class="demonstrated">{project.demonstrated}</p>
                  <div class="project-links">{project.links.map(link => <a class="text-link" href={link.href}>{link.label}<ArrowUpRight /></a>)}</div>
                </div>
                <div class="project-story">
                  <h4>Why I made it</h4><p>{project.purpose}</p>
                  <h4>What I built</h4><p>{project.approach}</p>
                  <h4>What the work demonstrates</h4><p>{project.evidence}</p>
                  <div class="reflection"><h4>What I take from it</h4><p>{project.reflection}</p></div>
                </div>
              </div>
            </article>
          ))}
          <p class="credits">These are my personal projects, developed with AI-assisted tooling. The linked sources document the software and third-party data used; the cycling map includes OpenStreetMap attribution.</p>
        </div>
      </section>

      <section id="experience" class="experience wrap" aria-labelledby="experience-title">
        <div class="section-label"><p class="eyebrow">Professional background</p><h2 id="experience-title">Experience<span>.</span></h2></div>
        <div class="roles">
          <article class="job">
            <div class="job-top"><h3>Adobe</h3><span>July 2015–present</span></div>
            <p class="job-title">Software Engineer / Behance &amp; Firefly</p>
            <ul>
              <li>Built location-discovery functionality using Elasticsearch geolocation and caching; coordinated with two frontend engineers and delivered a week before the Adobe MAX deadline.</li>
              <li>Delivered Paid Assets functionality for a peer-to-peer marketplace on schedule.</li>
              <li>Integrated feature-flag change notifications into Slack to help engineers trace changes and identify causes of issues more quickly.</li>
            </ul>
            <p class="job-skills">Backend development · Cross-team coordination · Delivery</p>
          </article>
          <article class="job">
            <div class="job-top"><h3>The Bosco</h3><span>March 2014–June 2015</span></div>
            <p class="job-title">Backend Developer / Brooklyn, NY</p>
            <p>Reworked a single-server CakePHP application into a scalable Laravel application on AWS. Built APIs for client applications and a budgeting tool that helped the sales team compare estimated and actual costs.</p>
            <p class="job-skills">API development · Scalability · Translating business needs</p>
          </article>
        </div>
      </section>

      <section id="education" class="education" aria-labelledby="education-title">
        <div class="wrap education-grid">
          <div><p class="eyebrow">Continuing to learn</p><h2 id="education-title">Education<span>.</span></h2>
            <h3>University of North Texas</h3>
            <p class="degree">Bachelor of Applied Arts and Sciences</p>
            <p>Concentration: Data Analytics<br />Expected graduation: December 2026</p>
            <p class="education-note">I’m bringing an analytical perspective to the systems I build: how data is collected, interpreted, and turned into useful decisions and experiences.</p>
          </div>
          <div class="skills"><h3>Skills I bring to the work</h3><dl>{skills.map(skill => <div><dt>{skill.name}</dt><dd>{skill.detail}</dd></div>)}</dl></div>
        </div>
      </section>
    </main>
    <footer class="wrap"><p>Andrew Landry <span aria-hidden="true">/</span> ePortfolio</p><div><a href="https://www.linkedin.com/in/andrew-landry-8520623/">LinkedIn <ArrowUpRight /></a><a href="https://github.com/andyroo2000">GitHub <ArrowUpRight /></a><a href="#name">Back to top ↑</a></div></footer>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-padding-top: 32px; }
  :global(body) { margin: 0; background: var(--site-bg); color: var(--site-text); font-family: 'Space Grotesk', sans-serif; font-size: 17px; line-height: 1.65; }
  :global(::selection) { background: #f2f76c; color: #2446ee; }
  h1, h2, h3, h4, p, figure, dl, dd { margin: 0; }
  h1, h2, h3 { font-weight: 500; line-height: 1.08; letter-spacing: -.045em; }
  a { color: inherit; text-underline-offset: 5px; }
  a:focus-visible { outline: 3px solid currentColor; outline-offset: 6px; }
  img { display: block; width: 100%; height: auto; }
  .wrap { width: min(1280px, 88%); margin-inline: auto; }
  .skip { position: fixed; top: -100px; left: 20px; z-index: 10; background: #fffef6; color: #2446ee; padding: 12px 20px; }
  .skip:focus { top: 16px; }
  .masthead { display: flex; align-items: center; gap: 28px; padding-block: 28px; border-bottom: 1px solid #ffffff45; font-size: 13px; }
  .monogram { display: flex; align-items: center; gap: 10px; text-decoration: none; font-size: 24px; font-weight: 700; letter-spacing: -.08em; }
  .monogram :global(svg) { width: 19px; height: 19px; }
  .edition { margin-right: auto; }
  nav { display: flex; flex-wrap: wrap; gap: 24px; }
  .masthead nav a { text-decoration: none; }
  .masthead nav a:hover { text-decoration: underline; }
  .intro { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 8%; align-items: center; padding-block: 90px 100px; }
  .eyebrow { font-size: 12px; line-height: 1.5; letter-spacing: .09em; text-transform: uppercase; font-weight: 600; }
  .intro .eyebrow { color: var(--site-accent); margin-bottom: 20px; }
  h1 { font-size: clamp(42px, 5.1vw, 72px); }
  h1 span { color: var(--site-accent); }
  .role { margin-top: 20px; font-size: 18px; }
  .role span { margin-inline: 5px; }
  .about { max-width: 740px; margin-top: 32px; }
  .about p + p { margin-top: 18px; }
  .text-link { display: inline-flex; align-items: center; gap: 12px; font-weight: 500; text-decoration-thickness: 1px; }
  .text-link :global(svg) { width: 17px; height: 17px; flex-shrink: 0; }
  .intro-link { margin-top: 28px; color: var(--site-accent); }
  .portrait { background: #fffef6; color: #2446ee; padding: 12px 12px 16px; transform: rotate(3deg); box-shadow: 9px 9px 0 #142ec2; }
  .portrait figcaption { margin-top: 14px; font-size: 12px; text-align: center; }
  .work { background: #fffef6; color: #1531b2; padding-block: 72px; }
  .section-heading { display: flex; justify-content: space-between; gap: 30px; align-items: end; }
  .section-heading > p { font-size: 16px; }
  h2 { font-size: clamp(36px, 4.1vw, 56px); margin-top: 12px; }
  .section-heading h2 span { color: #2446ee; }
  .project-index { border-block: 1px solid #2446ee45; margin-top: 36px; padding-block: 20px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
  .project-index a { display: flex; align-items: center; gap: 14px; text-decoration: none; font-size: 15px; }
  .project-index a:hover { text-decoration: underline; }
  .project-index a span:first-child { font-size: 11px; }
  .project-index a span:last-child { margin-left: auto; }
  .project { padding-block: 64px; border-bottom: 1px solid #2446ee45; }
  .project-heading { display: flex; align-items: center; gap: 24px; margin-bottom: 32px; }
  .project-number { font-size: 16px; border: 1px solid #2446ee; border-radius: 50%; width: 52px; height: 52px; display: grid; place-items: center; flex-shrink: 0; }
  .project-heading h3 { font-size: clamp(30px, 3vw, 42px); margin-top: 8px; }
  .project-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 6%; }
  .project-media figure img { border: 1px solid #2446ee35; aspect-ratio: 1710 / 896; object-fit: cover; }
  .project-media figcaption { margin-top: 12px; font-size: 13px; line-height: 1.5; }
  .project-meta { margin-top: 28px; padding-top: 22px; border-top: 1px solid #2446ee35; }
  .project-meta > div { display: grid; grid-template-columns: 65px 1fr; gap: 16px; margin-top: 8px; font-size: 14px; }
  dt { font-weight: 600; }
  .demonstrated { margin-top: 24px; font-size: 13px; font-weight: 500; }
  .project-links { display: flex; flex-direction: column; align-items: start; gap: 14px; margin-top: 28px; font-size: 15px; }
  .project-story { color: #253251; font-size: 16px; }
  h4 { font-size: 15px; color: #1531b2; font-weight: 600; margin-bottom: 8px; }
  .project-story > p { margin-bottom: 24px; }
  .reflection { border-left: 3px solid #2446ee; padding-left: 20px; }
  .credits { font-size: 13px; line-height: 1.6; max-width: 780px; padding-top: 26px; }
  .experience { display: grid; grid-template-columns: 1fr 2fr; gap: 8%; padding-block: 84px; }
  .experience h2 span { color: var(--site-accent); }
  .job + .job { border-top: 1px solid #ffffff45; margin-top: 40px; padding-top: 40px; }
  .job-top { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; }
  .job h3 { font-size: 30px; }
  .job-top > span { font-size: 13px; }
  .job-title { color: var(--site-accent); margin-block: 10px 20px; font-size: 15px; }
  .job ul { padding-left: 20px; margin: 0; }
  .job li + li { margin-top: 14px; }
  .job-skills { font-size: 13px; margin-top: 20px; color: var(--site-accent); }
  .education { background: #f2f76c; color: #1531b2; padding-block: 76px; }
  .education-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12%; }
  .education h3 { font-size: 25px; margin-top: 36px; }
  .degree { font-weight: 600; margin-block: 18px 8px; }
  .education-note { max-width: 460px; font-size: 15px; margin-top: 28px; }
  .skills h3 { margin-top: 0; }
  .skills dl { margin-top: 24px; }
  .skills dl > div { border-top: 1px solid #2446ee45; padding-block: 13px; }
  .skills dt { font-size: 14px; }
  .skills dd { font-size: 14px; margin-top: 3px; }
  footer { display: flex; justify-content: space-between; gap: 24px; padding-block: 30px; font-size: 13px; }
  footer > div { display: flex; flex-wrap: wrap; gap: 24px; }
  footer a { display: inline-flex; align-items: center; gap: 8px; }
  footer :global(svg) { width: 13px; height: 13px; }
  footer p span { margin-inline: 8px; }
  @media (max-width: 1000px) {
    .masthead { flex-wrap: wrap; gap: 14px 24px; }
    .masthead nav { width: 100%; }
    .intro { grid-template-columns: minmax(0, 1fr) 210px; gap: 5%; }
    .experience { grid-template-columns: 1fr; gap: 36px; }
    .education-grid { gap: 7%; }
  }
  @media (max-width: 700px) {
    :global(body) { font-size: 16px; }
    .wrap { width: 88%; }
    .masthead { padding-block: 20px; }
    .edition { font-size: 11px; }
    .masthead nav { gap: 12px 22px; font-size: 12px; }
    .intro { grid-template-columns: 1fr; padding-block: 48px 60px; gap: 36px; }
    h1 { font-size: clamp(36px, 8.8vw, 60px); }
    .role { font-size: 15px; }
    .portrait { width: 195px; justify-self: end; margin-right: 5px; }
    .section-heading { display: block; }
    .section-heading > p { margin-top: 20px; }
    .project-index { grid-template-columns: 1fr; gap: 16px; }
    .project { padding-block: 40px; }
    .project-heading { gap: 16px; }
    .project-number { width: 40px; height: 40px; font-size: 13px; }
    .project-heading .eyebrow { font-size: 10px; }
    .project-grid { grid-template-columns: 1fr; gap: 32px; }
    .work, .experience, .education { padding-block: 48px; }
    .job-top { display: block; }
    .job-top > span { display: block; margin-top: 10px; }
    .education-grid { grid-template-columns: 1fr; gap: 40px; }
    footer { flex-direction: column; }
  }
  @media print {
    :global(body) { background: white; color: #111; font-size: 11pt; }
    .masthead, .project-index, footer, .intro-link { display: none; }
    .wrap { width: 100%; }
    .intro, .work, .experience, .education { padding-block: 24px; background: white; color: #111; }
    .intro { grid-template-columns: 1fr 150px; }
    .portrait { transform: none; box-shadow: none; }
    h1, h2, h3, h4, h1 span, .job-title, .job-skills, .intro .eyebrow { color: #111; }
    .project-grid, .education-grid { grid-template-columns: 1fr; gap: 20px; }
    .project-media img { max-width: 420px; }
    .project-heading, h4 { break-after: avoid; }
    figure, .job { break-inside: avoid; }
  }
</style>
