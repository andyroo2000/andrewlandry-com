---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Music from '../../components/Music.astro';
---
<Base title="Andrew Landry — After hours" design="after-hours" theme="after-hours">
  <main id="main">
    <header><a class="brand" href="#main">andrew landry<span>—</span></a><nav><a href="#photographs">Visuals</a><a href="#sound">Sound</a><a href="#about">About</a></nav><span class="mono">Stay a little longer.</span></header>
    <section class="hero"><div class="hero-top mono"><span>Images for the eyes. Music for the rest.</span><span>Personal archive / Vol. 01</span></div><h1>A different<br />kind of <i>frequency.</i></h1><div class="hero-image"><Photo photo="yoko" eager /><span class="image-label mono">Yoko / From the photographic archive</span></div><a class="explore" href="#photographs" aria-label="Explore photographs">↓</a><p class="hero-note">An ongoing collection of<br />light, people, places, and sound.</p></section>
    <section id="sound" class="sound"><div class="section-heading"><span class="mono">01 / Listen</span><h2>Let the room<br />fill with sound.</h2><p>Synths, small experiments,<br />and somewhere to get lost.</p></div><Music /></section>
    <section id="photographs" class="visuals"><div class="strip-heading"><span class="mono">02 / Look</span><h2>Frames of reference.</h2><span class="mono">Brooklyn, 2020</span></div><div class="film-strip"><figure><Photo photo="shadow" /><figcaption><span>01</span>Light doing its thing.</figcaption></figure><figure><Photo photo="green" /><figcaption><span>02</span>Nothing out of the ordinary.</figcaption></figure><figure><Photo photo="road" /><figcaption><span>03</span>On the way to somewhere.</figcaption></figure></div></section>
    <section id="about" class="about"><p class="mono">Behind the signal</p><h2>I’m Andrew.<br />I make things <i>to feel.</i></h2><p>Sometimes a photograph. Sometimes a piece of music. This is where those things find each other.</p><div><a href="https://www.instagram.com/andrewlandry/">Instagram ↗</a><a href="https://www.behance.net/andrewlandry">Behance ↗</a></div></section>
    <footer><span>Andrew Landry</span><span class="mono">Thanks for tuning in.</span><a href="#main">↑ Top</a></footer>
  </main>
</Base>
<style>
:global(.after-hours){background:#10120f;color:#e9ece1}main{max-width:1800px;margin:auto;padding:0 5%}header{display:flex;align-items:center;justify-content:space-between;padding:31px 0;border-bottom:1px solid #ffffff25}.brand{font-family:'Space Grotesk',sans-serif;font-size:23px;letter-spacing:-1px}.brand span{color:#d7f749;margin-left:8px}nav{display:flex;gap:35px;font-size:13px}header>.mono{font-size:10px;color:#92988e}.hero{position:relative;padding-top:24px;padding-bottom:32px;border-bottom:1px solid #ffffff25}.hero-top{display:flex;justify-content:space-between;font-size:10px;color:#989c94}.hero h1{font-family:'Space Grotesk',sans-serif;font-weight:400;font-size:clamp(60px,9vw,145px);line-height:1.04;letter-spacing:-.075em;margin:42px 0 -34px;position:relative;z-index:2;pointer-events:none}.hero h1 i{font-family:'Instrument Serif',serif;font-weight:400;letter-spacing:-.045em;color:#d7f749}.hero-image{margin-left:32%;height:410px;position:relative}.hero-image :global(.photo-link),.hero-image :global(img){height:100%;object-fit:cover}.hero-image :global(img){filter:brightness(.64);object-position:center 45%}.image-label{position:absolute;bottom:18px;right:18px;font-size:9px;pointer-events:none}.explore{position:absolute;bottom:112px;left:0;border:1px solid #65704e;border-radius:50%;color:#d7f749;width:77px;height:77px;display:grid;place-items:center;font-size:35px}.explore:hover{background:#d7f749;color:#10120f}.hero-note{position:absolute;bottom:37px;left:0;font-size:13px;color:#a5ad9e;line-height:1.7}.sound{padding:80px 0;border-bottom:1px solid #ffffff25;display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}.section-heading .mono{color:#d7f749}.section-heading h2{font-size:48px;line-height:1.12;font-weight:400;letter-spacing:-2px;margin:23px 0}.section-heading>p:last-child{font-size:14px;line-height:1.7;color:#a5ad9e}.sound :global(.music-player){color:#d7f749;border-color:#56633a;background:#1d2416;--player-hover:#d7f74930}.strip-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:35px;gap:20px}.strip-heading h2{font-size:38px;letter-spacing:-2px;font-weight:400}.strip-heading>.mono{font-size:10px;color:#a5ad9e}.visuals{padding:70px 0}.film-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.film-strip :global(img){aspect-ratio:1.15;object-fit:cover}.film-strip figcaption{padding:18px 0;border-bottom:1px solid #ffffff25;display:flex;gap:20px;font-size:12px}.film-strip figcaption span{color:#d7f749;font-family:'DM Mono',monospace}.about{padding:70px 0 95px;max-width:850px}.about>.mono{color:#d7f749}.about h2{font-weight:400;font-size:clamp(40px,6vw,83px);line-height:1.05;letter-spacing:-4px;margin:30px 0}.about i{font-family:'Instrument Serif',serif;color:#d7f749}.about>p:not(.mono){max-width:390px;font-size:16px;line-height:1.8;color:#a5ad9e}.about>div{display:flex;gap:30px;font-size:13px;margin-top:35px}footer{display:flex;justify-content:space-between;align-items:center;padding:30px 0 105px;border-top:1px solid #ffffff25;font-size:13px}footer .mono{font-size:10px;color:#92988e}@media(max-width:700px){header>.mono{display:none}.brand{font-size:19px}nav{gap:18px;font-size:12px}.hero-top span:last-child{display:none}.hero h1{font-size:14vw;letter-spacing:-.07em;margin:45px 0 -10px}.hero-image{margin-left:14%;height:310px}.hero-note{position:static;margin-top:25px}.explore{bottom:39px;left:auto;right:0;width:52px;height:52px;font-size:25px}.image-label{font-size:8px}.sound{padding:50px 0;grid-template-columns:1fr;gap:25px}.section-heading h2{font-size:40px}.strip-heading{flex-wrap:wrap}.strip-heading h2{font-size:32px;order:3;width:100%}.film-strip{grid-template-columns:1fr;gap:30px}.film-strip :global(img){aspect-ratio:1.5}.about{padding:30px 0 60px}.about h2{letter-spacing:-2px}footer .mono{display:none}}
</style>
