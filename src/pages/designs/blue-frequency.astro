---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Music from '../../components/Music.astro';
---
<Base title="Andrew Landry — Blue frequency" design="blue-frequency" theme="blue-frequency">
  <main id="main">
    <header><a href="#main" class="brand">ANDREW<br />LANDRY</a><p>Eyes open.<br />Ears, too.</p><nav><a href="#look">Look</a><a href="#listen">Listen</a><a href="#about">Meet Andrew ↗</a></nav></header>
    <section class="poster"><div class="poster-type"><span class="mono">Photography, music & moving images</span><h1>LOOK.<br /><span>LISTEN.</span><br />REPEAT.</h1><div class="poster-bottom"><span class="mono">A collection by<br />Andrew Landry</span><a href="#look" aria-label="Explore photographs">↓</a></div></div><div class="poster-art"><Photo photo="road" eager /><div class="disc" aria-hidden="true"><span>AL</span></div><div class="art-caption mono"><span>Brooklyn, 2020</span><span>Something in the everyday.</span></div></div></section>
    <div class="ticker" aria-hidden="true"><span>PHOTOGRAPHS</span><b>✳</b><span>SOUNDS</span><b>✳</b><span>OBSERVATIONS</span><b>✳</b><span>PHOTOGRAPHS</span></div>
    <section id="look" class="look"><div class="section-header"><span class="mono">01 / Use your eyes</span><h2>Good things<br />are everywhere.</h2><p>A little attention<br />goes a long way.</p></div><div class="photo-grid"><figure><Photo photo="geometry" /><figcaption><h3>Brooklyn in color</h3><span>2020 ↗</span></figcaption></figure><figure><Photo photo="yoko" /><figcaption><h3>People in passing</h3><span>c. 2000 ↗</span></figcaption></figure></div><div class="wide-photo"><Photo photo="truck" /></div></section>
    <section id="listen" class="listen"><span class="mono">02 / Turn it up</span><div><h2>Less scrolling.<br /><i>More listening.</i></h2><Music /></div></section>
    <section id="about" class="about"><div class="about-mark" aria-hidden="true">a/l</div><div><span class="mono">Hello, I’m Andrew.</span><h2>Making a little<br />room for curiosity.</h2><p>I take pictures and make music. Different ways of noticing the same world. Welcome to my corner of it.</p><a href="https://www.instagram.com/andrewlandry/">Find me on Instagram ↗</a></div></section>
    <footer><strong>KEEP LOOKING.</strong><a href="#main">Back to top ↑</a></footer>
  </main>
</Base>
<style>
:global(.blue-frequency){background:#2446ee;color:#fff;font-family:'Space Grotesk',sans-serif}header{padding:28px 4%;display:flex;align-items:center;gap:12%;border-bottom:1px solid #ffffff60}.brand{font-size:22px;font-weight:700;letter-spacing:-1px;line-height:.93}header p{font-size:13px;line-height:1.4}nav{display:flex;margin-left:auto;gap:35px;font-size:13px}.poster{display:grid;grid-template-columns:1fr 1fr}.poster-type{padding:33px 8% 25px;display:flex;flex-direction:column}.poster-type>.mono{font-size:9px}.poster h1{font-size:clamp(70px,9.4vw,150px);line-height:.94;font-weight:700;letter-spacing:-.075em;margin:44px 0 30px}.poster h1 span{color:#f2f76c}.poster-bottom{display:flex;align-items:center;justify-content:space-between;margin-top:auto}.poster-bottom .mono{font-size:10px;line-height:1.6}.poster-bottom a{font-size:42px;border:1px solid #fff;width:64px;height:64px;display:grid;place-items:center;border-radius:50%}.poster-bottom a:hover{background:#f2f76c;color:#2446ee;border-color:#f2f76c}.poster-art{background:#f2f76c;padding:100px 35px 25px;position:relative;color:#2446ee;display:flex;flex-direction:column;justify-content:center}.poster-art :global(.photo-link){transform:rotate(-7deg);border:10px solid #fff;margin-top:30px;box-shadow:12px 12px 0 #2446ee}.poster-art :global(img){aspect-ratio:1.38;object-fit:cover}.disc{position:absolute;top:28px;right:40px;width:130px;height:130px;border-radius:50%;border:1px solid;display:grid;place-items:center;transform:rotate(15deg);font-weight:700;font-size:61px;letter-spacing:-8px;background:#f2f76c}.art-caption{display:flex;justify-content:space-between;gap:15px;font-size:9px;margin-top:57px}.ticker{display:flex;gap:35px;align-items:center;white-space:nowrap;overflow:hidden;background:#f2f76c;color:#2446ee;padding:16px 0;font-size:20px;font-weight:600;border-top:1px solid #2446ee}.ticker b{font-size:30px}.look{background:#f4f4ef;color:#2446ee;padding:75px 4%}.section-header{display:grid;grid-template-columns:1fr 2fr 1fr;align-items:start;gap:35px;margin-bottom:50px}.section-header .mono{font-size:10px}.section-header h2{font-size:clamp(38px,4.5vw,68px);line-height:1;letter-spacing:-3px}.section-header p{font-size:14px;line-height:1.6}.photo-grid{display:grid;grid-template-columns:1fr 1fr;gap:30px}.photo-grid :global(img){aspect-ratio:1.3;object-fit:cover}figcaption{display:flex;justify-content:space-between;padding:20px 0;border-bottom:1px solid #2446ee;align-items:center}figcaption h3{font-size:23px;font-weight:500;letter-spacing:-1px}figcaption>span{font-size:12px}.wide-photo{margin-top:40px}.wide-photo :global(img){aspect-ratio:2.7;object-fit:cover}.listen{padding:70px 4% 90px}.listen>.mono{font-size:10px}.listen>div{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center;margin-top:35px}.listen h2{font-size:clamp(35px,4.8vw,72px);letter-spacing:-3px;line-height:1.1}.listen i{font-family:'Instrument Serif',serif;font-weight:400;color:#f2f76c}.about{background:#f2f76c;color:#2446ee;display:grid;grid-template-columns:1fr 1.2fr;gap:70px;padding:75px 7%;align-items:center}.about-mark{font-size:clamp(130px,25vw,370px);font-weight:700;letter-spacing:-.15em;line-height:1}.about h2{font-size:48px;line-height:1.03;letter-spacing:-2px;margin:25px 0}.about p{font-size:16px;line-height:1.7;max-width:400px}.about a{display:inline-block;margin-top:25px;font-size:13px;border-bottom:1px solid;padding-bottom:5px}footer{padding:30px 4% 105px;display:flex;justify-content:space-between;align-items:center}footer strong{font-size:24px;letter-spacing:-1px}footer a{font-size:12px}@media(max-width:700px){header p{display:none}nav{gap:20px;font-size:12px}.brand{font-size:17px}.poster{grid-template-columns:1fr}.poster-type{padding:30px 6%}.poster h1{font-size:21vw;margin:35px 0}.poster-art{padding:60px 30px 25px}.disc{width:95px;height:95px;font-size:45px;right:25px;top:5px}.art-caption{margin-top:35px}.section-header{grid-template-columns:1fr;gap:20px}.section-header h2{font-size:47px;letter-spacing:-2px}.section-header p{display:none}.look{padding:45px 6%}.photo-grid{grid-template-columns:1fr}.photo-grid figcaption h3{font-size:21px}.wide-photo :global(img){aspect-ratio:1.5}.listen{padding:45px 6%}.listen>div{grid-template-columns:1fr;gap:30px}.listen h2{font-size:45px;letter-spacing:-2px}.about{grid-template-columns:1fr;gap:20px;padding:45px 6%}.about-mark{font-size:130px}.about h2{font-size:40px}footer strong{font-size:20px}}
</style>
