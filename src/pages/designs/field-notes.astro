---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Music from '../../components/Music.astro';
---
<Base title="Andrew Landry — Field notes" design="field-notes" theme="field-notes">
  <main id="main">
    <header><a href="#main" class="brand">Andrew Landry</a><span class="mono">A personal collection</span><nav><a href="#notes">The notebook</a><a href="#about">About Andrew</a></nav></header>
    <section class="intro"><div class="intro-copy"><span class="mono">Photos, sounds & other keepsakes</span><h1>A few things<br />worth <i>keeping.</i></h1><p>The people you meet. The streets you wander.<br />The little things that stay with you.</p><a href="#notes" class="underlined">Open the notebook <span>↓</span></a><div class="margin-note">Collected along the way.<br />Still a work in progress.</div></div><div class="collage"><figure class="back-print"><Photo photo="shadow" eager /><figcaption>Brooklyn, in the afternoon.</figcaption></figure><figure class="front-print"><Photo photo="vera" eager /><figcaption>Vera. From a box of old photographs.</figcaption></figure><span class="archive-mark mono">From<br />the<br />archive</span></div></section>
    <section id="notes" class="notes"><div class="section-title"><span class="mono">Pages from the notebook</span><span class="mono">No particular order</span></div><article class="story"><div class="story-photo"><Photo photo="joe" /><span class="mono">01 / A familiar face</span></div><div class="story-copy"><span class="mono">Photographs · c. 2000</span><h2>This was Joe.</h2><p>He used to always ask me if I had a cigarette. When I told him I didn’t smoke, he seemed very happy and told me that I shouldn’t smoke.</p><p>He was friends with people from The Village Copier, and they let him photocopy entire philosophy books for free. His jacket was always bursting with the pages.</p><span class="handwritten">Funny, the things you remember.</span></div></article><article class="story reverse"><div class="story-photo"><Photo photo="green" /><span class="mono">02 / Out for a walk</span></div><div class="story-copy"><span class="mono">Brooklyn · 2020</span><h2>Nothing much.<br />Everything, really.</h2><p>A collection of walls, shadows, parked trucks, and the geometry hiding in an ordinary day.</p><a href="https://andrewlandry.myportfolio.com/photos-of-things-brooklyn" class="underlined">The complete collection ↗</a></div></article></section>
    <section class="listening" id="music"><div><span class="mono">Something to listen to</span><h2>A different kind<br />of <i>note.</i></h2></div><Music /></section>
    <section id="about" class="about"><span class="asterisk" aria-hidden="true">✳</span><h2>A notebook, not a finish line.</h2><p>I’m Andrew. I take pictures, make music, and collect little pieces of the world. This is a place to put them.</p><a href="https://www.instagram.com/andrewlandry/" class="underlined">Find me elsewhere ↗</a></section>
    <footer><span>Andrew Landry</span><span class="handwritten">Until next time.</span><a href="#main">Back to the beginning ↑</a></footer>
  </main>
</Base>
<style>
:global(.field-notes){background:#eee9df;color:#352f28}main{max-width:1450px;padding:0 6%;margin:auto}header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #afa89a;padding:30px 0}.brand{font-family:'Instrument Serif',serif;font-size:29px}.mono{font-size:10px;color:#786d5e}header nav{display:flex;gap:30px;font-size:13px}.intro{min-height:680px;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:15px}.intro-copy{position:relative;padding:65px 0}.intro h1{font-family:'Instrument Serif',serif;font-size:clamp(65px,7.9vw,116px);font-weight:400;line-height:1.01;letter-spacing:-3px;margin:27px 0}.intro h1 i{color:#ac3b24}.intro p{font-size:15px;line-height:1.8;color:#62594d}.underlined{display:inline-flex;gap:38px;align-items:center;padding-bottom:6px;border-bottom:1px solid;font-size:14px;margin-top:27px}.margin-note{font-family:'Instrument Serif',serif;font-size:20px;line-height:1.25;color:#756752;transform:rotate(-7deg);margin:43px 0 0 15px}.collage{position:relative;min-height:580px}.collage figure{padding:13px 13px 35px;background:#faf9f4;box-shadow:3px 10px 30px #352f2820;position:absolute}.collage figcaption{font-family:'Instrument Serif',serif;font-style:italic;font-size:17px;padding:14px 3px 0}.back-print{width:83%;top:10px;right:0;transform:rotate(7deg)}.front-print{width:87%;bottom:25px;left:-15px;transform:rotate(-8deg)}.front-print::before{content:'';position:absolute;left:40%;top:-15px;width:75px;height:27px;background:#cdbb8880;transform:rotate(10deg);z-index:2}.archive-mark{position:absolute;right:-10px;bottom:15px;display:grid;place-content:center;width:90px;height:90px;border:2px solid #ac3b24;border-radius:50%;text-align:center;transform:rotate(13deg);color:#ac3b24;line-height:1.5}.section-title{display:flex;justify-content:space-between;border-top:1px solid #afa89a;border-bottom:1px solid #afa89a;padding:17px 0}.story{display:grid;grid-template-columns:1.1fr 1fr;gap:9%;padding:65px 0}.story-photo .mono{display:block;margin-top:14px}.story-copy{padding-top:20px}.story-copy h2{font-family:'Instrument Serif',serif;font-size:55px;line-height:1.05;font-weight:400;margin:20px 0}.story-copy p{font-size:15px;line-height:1.85;max-width:405px;margin:17px 0}.handwritten{font-family:'Instrument Serif',serif;font-style:italic;font-size:21px;color:#ac3b24}.story-copy .handwritten{display:block;transform:rotate(-3deg);margin:24px 0}.reverse .story-photo{order:2}.listening{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;padding:50px 0;border-top:1px solid #afa89a;border-bottom:1px solid #afa89a}.listening h2{font-family:'Instrument Serif',serif;font-size:59px;font-weight:400;line-height:1.08;margin-top:15px}.listening i{color:#ac3b24}.listening :global(.music-player){border-color:#b6ac9c;background:#e4dccd}.about{max-width:600px;margin:75px auto;text-align:center}.asterisk{font-size:50px;color:#ac3b24}.about h2{font-family:'Instrument Serif',serif;font-size:43px;font-weight:400;margin:20px 0}.about p{line-height:1.8;font-size:16px;color:#62594d}footer{border-top:1px solid #afa89a;padding:30px 0 110px;display:flex;align-items:center;justify-content:space-between;font-size:12px}@media(max-width:700px){header>.mono{display:none}header nav{font-size:11px;gap:20px}.brand{font-size:24px}.intro{grid-template-columns:1fr;gap:0}.intro-copy{padding:50px 0 20px}.intro h1{font-size:77px}.margin-note{display:none}.collage{min-height:430px;margin:0 10px 30px}.back-print{width:72%;top:0}.front-print{width:79%;bottom:20px;left:0}.archive-mark{width:70px;height:70px;font-size:8px;right:-5px;bottom:0}.story{grid-template-columns:1fr;gap:20px;padding:40px 0}.story-copy{padding:0}.story-copy h2{font-size:47px}.reverse .story-photo{order:0}.listening{grid-template-columns:1fr;gap:25px}.listening h2{font-size:51px}.about{margin:50px auto}.about h2{font-size:36px}footer .handwritten{display:none}footer{font-size:11px}.section-title .mono:last-child{display:none}}
</style>
