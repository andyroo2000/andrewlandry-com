---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Music from '../../components/Music.astro';
---
<Base title="Andrew Landry — Still life" design="still-life" theme="still-life">
  <main id="main">
    <header><span class="mono">Photographs & sound</span><a class="brand" href="#main">Andrew Landry</a><nav><a href="#works">Works</a><a href="#about">About</a></nav></header>
    <section class="gallery-intro"><h1 class="intro-line">A small collection of <i>the things that remain.</i></h1><div class="hero-work"><span class="vertical-label mono">Selected photograph / c. 2000</span><div class="hero-image"><Photo photo="vera" eager /></div><span class="side-note">The people.<br />The places.<br />The light.</span></div><div class="hero-caption"><span>Vera</span><span class="mono">From the photographic archive</span><a href="#works" aria-label="Explore selected works">↓</a></div></section>
    <section class="works" id="works"><div class="section-title"><span class="mono">Selected works</span><p>Look slowly.</p><span class="mono">01 — 03</span></div><article class="work-one"><div><Photo photo="shadow" /><div class="caption"><h2>Afternoon, in passing</h2><span class="mono">Brooklyn, 2020</span></div></div><p>Sometimes it’s simply<br />a shadow on a wall.</p></article><article class="work-two"><div><Photo photo="joe" /><div class="caption"><h2>Joe</h2><span class="mono">c. 2000</span></div></div><p class="work-note">His jacket was always bursting<br />with photocopied philosophy books.</p></article><article class="work-three"><Photo photo="geometry" /><div class="caption"><h2>Concrete & sky</h2><span class="mono">Brooklyn, 2020</span></div></article></section>
    <section id="sound" class="sound"><div><span class="mono">Also, music</span><h2>Another way<br />of <i>paying attention.</i></h2></div><Music /></section>
    <section id="about" class="about"><span class="mono">About Andrew</span><div><p>I make photographs and music.<br />This is a place for both.</p><p class="small">An archive of encounters, observations, and experiments. Some from a long time ago. Some still finding their shape.</p><a href="https://www.behance.net/andrewlandry">Elsewhere on the internet ↗</a></div></section>
    <footer><span>Andrew Landry</span><a href="#main">Return to the beginning ↑</a></footer>
  </main>
</Base>
<style>
:global(.still-life){background:#fcfcf9;color:#3a4237}main{max-width:1600px;margin:auto;padding:0 6.5%}header{display:grid;grid-template-columns:1fr 2fr 1fr;align-items:center;padding:35px 0;border-bottom:1px solid #d6d9cf}.brand{font-family:'Libre Caslon Display',serif;font-size:39px;text-align:center;letter-spacing:-1px}header>.mono{font-size:9px;color:#747d6f}nav{display:flex;gap:26px;justify-content:end;font-size:12px}.gallery-intro{padding:35px 0 75px}.intro-line{font-weight:400;text-align:center;font-family:'Instrument Serif',serif;font-size:21px;color:#788070;margin-bottom:48px}.hero-work{display:grid;grid-template-columns:1fr 5.6fr 1fr;gap:32px;align-items:center}.hero-image{padding:0 18px}.hero-image :global(img){width:100%;height:auto}.vertical-label{writing-mode:vertical-rl;transform:rotate(180deg);font-size:9px;justify-self:end;color:#747d6f}.side-note{font-family:'Instrument Serif',serif;font-style:italic;font-size:24px;line-height:1.4;margin-left:10px}.hero-caption{margin:25px auto 0;max-width:73.5%;padding:0 18px;display:flex;align-items:center;justify-content:space-between}.hero-caption>span:first-child{font-family:'Instrument Serif',serif;font-size:22px}.hero-caption .mono{font-size:9px;color:#747d6f}.hero-caption>a{font-size:23px}.section-title{display:flex;align-items:center;justify-content:space-between;border-top:1px solid #d6d9cf;padding:25px 0}.section-title .mono{font-size:10px;color:#747d6f}.section-title p{font-family:'Instrument Serif',serif;font-size:36px;font-style:italic}.works article{margin:65px 0 100px}.work-one{display:grid;grid-template-columns:1.65fr 1fr;gap:70px;align-items:center}.work-one>p,.work-note{font-family:'Instrument Serif',serif;font-size:25px;line-height:1.5;color:#747d6f}.caption{display:flex;justify-content:space-between;align-items:center;margin-top:18px;gap:20px}.caption h2{font-family:'Instrument Serif',serif;font-size:25px;font-weight:400}.caption .mono{font-size:9px;color:#747d6f}.work-two{width:58%;margin-left:auto!important}.work-note{font-size:21px;margin-top:28px}.work-three{width:80%;margin-right:auto!important}.sound{border-top:1px solid #d6d9cf;padding:65px 0;display:grid;grid-template-columns:1.2fr 1fr;gap:60px;align-items:center}.sound .mono{font-size:10px;color:#747d6f}.sound h2{font-family:'Instrument Serif',serif;font-size:clamp(40px,4.7vw,65px);line-height:1.1;font-weight:400;margin-top:22px}.sound :global(.music-player){border-color:#a6af9c;background:#f2f4ec;--player-hover:#b6bea340}.about{border-top:1px solid #d6d9cf;display:grid;grid-template-columns:1fr 2fr;padding:75px 0;gap:40px}.about>.mono{font-size:10px;color:#747d6f}.about p{font-family:'Instrument Serif',serif;font-size:42px;line-height:1.2}.about .small{font-family:'DM Sans',sans-serif;font-size:15px;line-height:1.9;color:#747d6f;max-width:400px;margin-top:25px}.about a{display:inline-block;font-size:12px;border-bottom:1px solid #b4bcae;padding-bottom:6px;margin-top:25px}footer{padding:25px 0 110px;border-top:1px solid #d6d9cf;display:flex;justify-content:space-between;font-size:11px;color:#747d6f}footer>span{font-family:'Instrument Serif',serif;font-size:24px}@media(max-width:700px){main{padding:0 6%}header{grid-template-columns:1fr auto;gap:15px;padding:24px 0}header>.mono{display:none}.brand{text-align:left;font-size:30px}nav{font-size:11px;gap:20px}.intro-line{font-size:20px;margin-bottom:35px}.gallery-intro{padding-bottom:40px}.hero-work{grid-template-columns:1fr;gap:0}.hero-image{padding:0}.vertical-label,.side-note{display:none}.hero-caption{max-width:100%;padding:0;gap:15px}.hero-caption .mono{font-size:8px}.section-title p{font-size:30px}.section-title .mono{font-size:8px}.works article{margin:30px 0 55px}.work-one{grid-template-columns:1fr;gap:20px}.work-one>p{font-size:21px}.work-two{width:87%}.work-three{width:100%}.caption h2{font-size:23px}.sound{grid-template-columns:1fr;padding:45px 0;gap:25px}.sound h2{font-size:44px}.about{grid-template-columns:1fr;padding:45px 0;gap:25px}.about p{font-size:35px}}
</style>
