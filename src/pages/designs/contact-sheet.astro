---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Music from '../../components/Music.astro';
---
<Base title="Andrew Landry — Contact sheet" design="contact-sheet" theme="contact-sheet">
  <main id="main">
    <header><a href="#main" class="brand">AL<span>*</span></a><p>Photographs, music,<br />and everything in between.</p><nav><a href="#work">Selected work</a><a href="#about">About</a><a href="https://www.instagram.com/andrewlandry/">Elsewhere ↗</a></nav></header>
    <h1>Andrew Landry<span>*</span></h1>
    <div class="rule mono"><span>Independent observations</span><span>Photography / Sound / Moving image</span><span>Selected, 2000—2022</span></div>
    <section class="lead" id="work"><div class="lead-photo"><Photo photo="geometry" eager /><span class="image-index mono">01 / Brooklyn, 2020</span></div><div class="lead-copy"><p class="mono">01 — Photography</p><h2>Things<br />I noticed.</h2><p>A walk. A wall. A certain kind of light. Photographs of things in Brooklyn.</p><a href="#photographs" class="round-link" aria-label="Explore photographs">↘</a><span class="mono">Look a little closer</span></div></section>
    <section class="work-grid" id="photographs"><article><Photo photo="shadow" /><div><h3>Photos of things</h3><span class="mono">Brooklyn / 2020</span></div></article><article><Photo photo="yoko" /><div><h3>Old photos</h3><span class="mono">From the archive</span></div></article></section>
    <section class="sound" id="music"><div><span class="mono">02 — Sound</span><h2>Made to<br />be heard.</h2></div><Music /></section>
    <section id="about" class="about"><span class="mono">A little context</span><p>I’m Andrew. I take photographs, make music, and keep coming back to the things that catch my attention.</p><a href="https://www.behance.net/andrewlandry">Find me on Behance ↗</a></section>
    <footer><strong>Thanks for looking.</strong><a href="#main">Back to top ↑</a></footer>
  </main>
</Base>
<style>
:global(.contact-sheet){background:#f8f8f5;color:#181818}main{max-width:1800px;margin:auto;padding:0 3.4%}header{display:flex;align-items:center;gap:12%;padding:26px 0 35px}.brand{font-size:32px;font-weight:700;letter-spacing:-3px}.brand span{font-size:13px;vertical-align:top;letter-spacing:0}header p{font-size:13px;line-height:1.45}nav{margin-left:auto;display:flex;gap:30px;font-size:13px}nav a:hover{text-decoration:underline}h1{font-family:'Space Grotesk',sans-serif;font-size:clamp(55px,12.2vw,205px);font-weight:600;line-height:1.05;letter-spacing:-.075em;white-space:nowrap;margin:10px 0 32px}h1 span{font-size:.15em;vertical-align:top;line-height:2.5;letter-spacing:0;margin-left:10px}.rule{display:flex;justify-content:space-between;border-top:2px solid;padding:16px 0 24px;font-size:10px}.lead{display:grid;grid-template-columns:2.05fr 1fr;background:#ef3829}.lead-photo{position:relative}.lead-photo :global(.photo-link),.lead-photo :global(img){height:100%;object-fit:cover;min-height:430px}.image-index{position:absolute;bottom:18px;left:20px;color:#fff;font-size:11px}.lead-copy{padding:32px;display:flex;align-items:start;flex-direction:column}.lead-copy h2{font-size:clamp(42px,5.8vw,90px);font-weight:500;letter-spacing:-.065em;line-height:1;margin:38px 0 22px}.lead-copy>p:not(.mono){font-size:15px;line-height:1.6;max-width:250px}.round-link{border:1px solid;border-radius:50%;font-size:44px;line-height:1;width:73px;height:73px;display:grid;place-items:center;margin:27px 0 16px}.round-link:hover{background:#181818;color:#ef3829}.lead-copy>span{font-size:10px}.work-grid{display:grid;grid-template-columns:1fr 1fr;gap:32px;margin:60px 0}.work-grid :global(img){aspect-ratio:1.5;object-fit:cover}.work-grid article>div{display:flex;justify-content:space-between;align-items:center;padding:16px 0;border-bottom:1px solid #aaa}.work-grid h3{font-size:24px;font-weight:500;letter-spacing:-1px}.work-grid .mono{font-size:10px}.sound{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:32px;border-top:1px solid;padding:50px 0}.sound h2{font-size:65px;font-weight:500;letter-spacing:-4px;line-height:1.02;margin-top:20px}.about{border-top:1px solid;display:grid;grid-template-columns:1fr 2fr;gap:30px;padding:55px 0}.about p{font-size:clamp(25px,3vw,43px);line-height:1.2;letter-spacing:-1.5px;max-width:790px}.about>a{grid-column:2;font-size:14px;text-decoration:underline}footer{padding:30px 0 110px;border-top:2px solid;display:flex;justify-content:space-between;font-size:13px}footer strong{font-weight:500}@media(max-width:700px){header{gap:30px;padding:20px 0}header p{display:none}nav{gap:17px;font-size:12px}h1{font-size:11.7vw;margin:25px 0}.rule span:nth-child(2){display:none}.rule{font-size:8px}.lead{grid-template-columns:1fr}.lead-photo :global(img){min-height:0;aspect-ratio:1.5}.lead-copy{padding:27px;display:grid;grid-template-columns:1fr auto;gap:18px}.lead-copy .mono,.lead-copy h2,.lead-copy>p{grid-column:1}.lead-copy h2{margin:0;font-size:57px}.lead-copy .round-link{grid-column:2;grid-row:2/4;margin:0;align-self:center}.lead-copy>span{display:none}.work-grid{gap:25px;grid-template-columns:1fr;margin:35px 0}.sound{grid-template-columns:1fr}.sound h2{font-size:52px}.about{grid-template-columns:1fr}.about>a{grid-column:1}.about p{font-size:30px}}
</style>
