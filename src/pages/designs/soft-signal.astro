---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Music from '../../components/Music.astro';
const selections = [
  {photo:'geometry' as const,type:'photo',title:'Concrete & sky',category:'Photography',year:'2020'},
  {photo:'yoko' as const,type:'photo',title:'From the archive',category:'Photography',year:'c. 2000'},
  {photo:'shadow' as const,type:'photo',title:'Afternoon, in passing',category:'Photography',year:'2020'},
];
---
<Base title="Andrew Landry — Soft signal" design="soft-signal" theme="soft-signal">
  <main id="main">
    <header><a href="#main" class="brand"><span class="brand-symbol" aria-hidden="true">a.</span>andrew landry</a><nav><a href="#collection">My collection</a><a href="#about">A little about me</a></nav><a href="https://www.instagram.com/andrewlandry/" class="external">Say hello ↗</a></header>
    <section class="hero"><div class="hero-copy"><span class="label">A PERSONAL TRANSMISSION</span><h1>Bits, beeps<br />& everything<br /><i>in between.</i></h1><div class="hero-bottom"><p>I’m Andrew. I make music,<br />take pictures, and follow my curiosity.</p><a href="#collection" class="explore" aria-label="Explore my collection">↘</a></div></div><div class="hero-right"><div class="photo-card"><div class="card-top"><span class="mono">Visual memory 001</span><span aria-hidden="true">✳</span></div><Photo photo="truck" eager /><div class="card-bottom"><span>Somewhere in Brooklyn.</span><span class="mono">2020</span></div></div><div class="sound-card"><span class="mono">On a different wavelength</span><Music /></div></div></section>
    <section id="collection" class="collection"><div class="collection-header"><div><span class="mono">An assortment of good things</span><h2>The collection.</h2></div><div class="filters" role="group" aria-label="Filter the collection"><button class="active" data-filter="all" aria-pressed="true">Everything</button><button data-filter="photo" aria-pressed="false">Pictures</button><button data-filter="sound" aria-pressed="false">Sounds</button></div></div><p class="sr-only" role="status" id="filter-status">Showing all 4 items</p><div class="collection-grid">{selections.map(item=><article data-kind={item.type}><Photo photo={item.photo} /><div class="item-label"><span class="mono">{item.category} / {item.year}</span><h3>{item.title}</h3></div></article>)}<article data-kind="sound" class="collection-sound"><div class="sound-art" aria-hidden="true"><span>GOOD<br />VIBRATIONS.</span><div class="wave-bars">{Array.from({length:18},(_,i)=><b style={`--height:${20+((i*37)%80)}%`}></b>)}</div></div><div class="item-label"><span class="mono">Sound / 2022</span><h3>Synth and Chill</h3></div><Music label="Play Synth and Chill" /></article></div></section>
    <section id="about" class="about"><div><span class="mono">The person behind the pixels</span><h2>Curiosity is<br />the common thread.</h2><p>Between a photograph and a piece of music, there’s a lot to explore. This little corner of the internet is where I keep what I find.</p><div class="socials"><a href="https://www.instagram.com/andrewlandry/">Instagram ↗</a><a href="https://www.behance.net/andrewlandry">Behance ↗</a></div></div><div class="about-tile"><span class="mono">Keep your eyes & ears open.</span><strong>There’s<br />always<br /><i>something.</i></strong><span class="tile-star" aria-hidden="true">✳</span></div></section>
    <footer><a class="brand" href="#main"><span class="brand-symbol" aria-hidden="true">a.</span>andrew landry</a><p>Thanks for dropping by.<br />Come back when you feel like it.</p><a href="#main">Back up ↑</a></footer>
  </main>
</Base>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button=>{
    button.addEventListener('click',()=>{
      const filter=button.dataset.filter;
      document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(b=>{b.classList.toggle('active',b===button);b.setAttribute('aria-pressed',String(b===button));});
      let count=0;
      document.querySelectorAll<HTMLElement>('[data-kind]').forEach(item=>{item.hidden=filter!=='all'&&item.dataset.kind!==filter;if(!item.hidden)count++;});
      const status=document.querySelector('#filter-status');
      if(status)status.textContent=`Showing ${count} ${filter==='all'?'items':filter==='photo'?'pictures':'sound recording'}`;
    });
  });
</script>
<style>
:global(.soft-signal){background:#f5f2ee;color:#292332;font-family:'Space Grotesk',sans-serif}main{max-width:1660px;margin:auto;padding:0 4%}header{display:flex;justify-content:space-between;align-items:center;padding:28px 0}.brand{display:flex;gap:10px;align-items:center;font-size:21px;font-weight:600;letter-spacing:-.8px}.brand-symbol{width:35px;height:35px;border-radius:50%;background:#292332;color:#f3caa9;font-size:29px;line-height:1;text-align:center;letter-spacing:-3px;padding-right:4px}nav{display:flex;gap:30px;font-size:12px}.external{padding:11px 18px;border:1px solid #292332;border-radius:30px;font-size:12px}.hero{display:grid;grid-template-columns:1.15fr 1fr;gap:20px}.hero-copy{background:#aa85ec;border-radius:18px;padding:34px;display:flex;flex-direction:column}.label{font-family:'DM Mono',monospace;font-size:9px;letter-spacing:.1em}.hero h1{font-size:clamp(50px,6.6vw,105px);line-height:1.01;letter-spacing:-.075em;font-weight:500;margin:50px 0 40px}.hero h1 i{font-family:'Instrument Serif',serif;font-weight:400;letter-spacing:-.04em}.hero-bottom{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:auto}.hero-bottom p{font-size:13px;line-height:1.6}.explore{background:#292332;color:#aa85ec;border-radius:50%;width:65px;height:65px;display:grid;place-items:center;font-size:36px;flex-shrink:0}.explore:hover{background:#fff;color:#292332}.hero-right{display:grid;grid-template-rows:1fr auto;gap:20px}.photo-card{background:#fff;border-radius:18px;overflow:hidden}.card-top{padding:15px 22px;display:flex;align-items:center;justify-content:space-between}.card-top .mono{font-size:9px}.card-top>span:last-child{font-size:26px}.photo-card :global(img){aspect-ratio:1.8;object-fit:cover}.card-bottom{display:flex;justify-content:space-between;align-items:center;padding:19px 22px;font-size:14px}.card-bottom .mono{font-size:10px}.sound-card{background:#e8ee8e;border-radius:18px;padding:20px 22px 5px}.sound-card>.mono{font-size:9px}.sound-card :global(.music-player){border:0}.sound-card :global(.music-start){padding:15px 0;min-height:95px}.sound-card :global(.player-wave){display:none}.collection{padding:75px 0}.collection-header{display:flex;align-items:end;justify-content:space-between;margin-bottom:35px;gap:20px}.collection-header .mono{font-size:9px;color:#776d81}.collection h2{font-size:49px;font-weight:500;letter-spacing:-3px;margin-top:12px}.filters{display:flex;padding:5px;border:1px solid #d5cddc;border-radius:30px;gap:3px}.filters button{font-size:12px;border:0;background:transparent;border-radius:25px;padding:10px 16px}.filters button.active{background:#292332;color:#fff}.collection-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:28px}.collection-grid article{background:#fff;border-radius:15px;overflow:hidden}.collection-grid article[hidden]{display:none}.collection-grid :global(img){aspect-ratio:1.8;object-fit:cover}.item-label{padding:23px}.item-label .mono{font-size:9px;color:#776d81}.item-label h3{font-weight:500;font-size:24px;letter-spacing:-1px;margin-top:9px}.sound-art{aspect-ratio:1.8;background:#f3caa9;padding:25px;display:flex;align-items:center;position:relative;overflow:hidden}.sound-art>span{font-size:clamp(35px,4vw,62px);font-weight:700;letter-spacing:-3px;line-height:1.05;z-index:1}.wave-bars{position:absolute;inset:25px 25px 25px 40%;display:flex;gap:8px;align-items:center;opacity:.15}.wave-bars b{height:var(--height);flex:1;border-radius:10px;background:#292332}.collection-sound :global(.music-player){border:0;border-top:1px solid #ddd5e4}.collection-sound :global(.music-start){padding:15px 23px;min-height:85px}.collection-sound :global(.music-start strong){font-size:14px}.collection-sound :global(.music-start small){font-size:9px}.about{padding:15px 0 70px;display:grid;grid-template-columns:1.1fr 1fr;gap:12%;align-items:center}.about .mono{font-size:9px;color:#776d81}.about h2{font-size:50px;font-weight:500;letter-spacing:-2.5px;line-height:1.1;margin:22px 0}.about p{font-size:15px;line-height:1.8;max-width:420px;color:#776d81}.socials{display:flex;gap:25px;margin-top:27px;font-size:12px}.about-tile{padding:28px;background:#f3caa9;position:relative;border-radius:18px;min-height:330px}.about-tile strong{font-size:68px;line-height:1;letter-spacing:-4px;display:block;font-weight:500;margin-top:45px}.about-tile i{font-family:'Instrument Serif',serif;letter-spacing:-2px}.tile-star{position:absolute;right:25px;top:50px;font-size:82px;color:#8060b5}footer{padding:30px 0 110px;border-top:1px solid #d5cddc;display:flex;justify-content:space-between;align-items:center;gap:30px}footer p{font-size:12px;line-height:1.6;color:#776d81}footer>a:last-child{font-size:12px}.sr-only{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}@media(max-width:700px){header{padding:22px 0}header nav{display:none}.brand{font-size:19px}.external{font-size:11px;padding:10px 14px}.hero{grid-template-columns:1fr;gap:15px}.hero-copy{padding:28px}.hero h1{font-size:15vw;letter-spacing:-.065em;margin:35px 0}.hero-bottom p{font-size:12px}.explore{width:53px;height:53px;font-size:30px}.hero-right{gap:15px}.collection{padding:45px 0}.collection-header{display:block}.collection h2{font-size:43px}.filters{width:fit-content;margin-top:24px}.filters button{padding:9px 16px}.collection-grid{grid-template-columns:1fr;gap:20px}.about{grid-template-columns:1fr;gap:35px;padding-bottom:50px}.about h2{font-size:42px}.about-tile strong{font-size:63px}.about-tile{min-height:315px}footer p{display:none}footer .brand{font-size:17px}.sound-art>span{font-size:45px}}
</style>
