---
import ArrowUpRight from '../components/ArrowUpRight.astro';
import ThemeHead from '../components/ThemeHead.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const description = 'Andrew Landry’s Japan cycling trips, Synth & Chill sessions, and links to GitHub, LinkedIn, and Instagram.';
const shareImage = 'https://andrewlandry.com/images/social-share.png';
const shareImageAlt = 'Andrew Landry in white and lemon lettering on cobalt blue, beside a tilted card of social links.';
const links = [
  { name: 'GitHub', handle: 'andyroo2000', href: 'https://github.com/andyroo2000' },
  { name: 'LinkedIn', handle: 'Andrew Landry', href: 'https://www.linkedin.com/in/andrew-landry-8520623/' },
  { name: 'Instagram', handle: 'andrewlandry', href: 'https://www.instagram.com/andrewlandry/' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeHead />
    <meta name="description" content={description} />
    <link rel="canonical" href="https://andrewlandry.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Andrew Landry" />
    <meta property="og:title" content="Andrew Landry" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://andrewlandry.com/" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Andrew Landry" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareImageAlt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>Andrew Landry</title>
  </head>
  <body class="blue-frequency">
    <a href="#main" class="skip">Skip to content</a>
    <div class="page-settings"><ThemeToggle /></div>
  <main id="main" class="id-page">
    <section class="identity" aria-label="Andrew Landry">
      <h1>ANDREW<br /><span>LANDRY</span></h1>
      <nav class="featured-pages" aria-label="Films and music">
        <a href="/japan-cycling-trips/" class="featured-link" aria-labelledby="featured-trip-title" aria-describedby="featured-trip-detail">
          <span class="featured-title"><span id="featured-trip-title">Japan Cycling Trips</span><span class="featured-arrow" aria-hidden="true">→</span></span>
          <span class="featured-subtitle" id="featured-trip-detail">Hokkaido · 2025 &amp; 2026</span>
        </a>
        <a href="/synth-and-chill/" class="featured-link" aria-labelledby="featured-synth-title" aria-describedby="featured-synth-detail">
          <span class="featured-title"><span id="featured-synth-title">Synth &amp; Chill</span><span class="featured-arrow" aria-hidden="true">→</span></span>
          <span class="featured-subtitle" id="featured-synth-detail">Basement synthesizer sessions</span>
        </a>
      </nav>
    </section>
    <section class="links-panel" aria-label="Social profiles">
      <div class="link-sheet">
        <header class="sheet-heading"><h2>Elsewhere.</h2></header>
        <nav aria-label="Andrew’s profiles">
          {links.map(link => (
            <a href={link.href} class="profile-link" target="_blank" rel="noopener noreferrer" aria-label={`${link.name} ${link.handle} (opens in a new tab)`}>
              <span class="link-copy"><strong>{link.name}</strong><span>{link.handle}</span></span>
              <span class="link-arrow" aria-hidden="true"><ArrowUpRight /></span>
            </a>
          ))}
        </nav>
        <div class="seal" aria-hidden="true">AL</div>
      </div>
    </section>
  </main>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; }
  h1, h2 { margin: 0; }
  a { color: inherit; text-decoration: none; touch-action: manipulation; }
  a:focus-visible { outline: 3px solid currentColor; outline-offset: 5px; }
  ::selection { background: var(--lemon); color: var(--blue); }
  .skip { position: fixed; top: -100px; left: 15px; background: #fff; color: #000; padding: 12px; z-index: 100; }
  .skip:focus { top: 15px; }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
  :global(.blue-frequency) {
    --blue: #2446ee;
    --lemon: #f2f76c;
    background: var(--site-bg);
    color: var(--site-text);
    font-family: 'Space Grotesk', sans-serif;
  }
  .page-settings { position: absolute; top: 24px; right: 4vw; z-index: 2; color: var(--site-ink); --theme-toggle-accent: var(--site-ink); }
  .id-page {
    min-height: 100svh;
    display: grid;
    grid-template-columns: 55fr 45fr;
  }
  .identity {
    padding: 60px 7.5%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: clamp(32px, 4vh, 52px);
  }
  h1 {
    font-size: clamp(65px, 11.2vw, 210px);
    line-height: .98;
    letter-spacing: -.04em;
    font-weight: 600;
  }
  h1 span { color: var(--lemon); }
  .featured-pages { display: flex; flex-direction: column; gap: 18px; max-width: 100%; }
  .featured-link {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 100%;
    padding: 8px 0;
    color: var(--lemon);
  }
  .featured-title {
    display: flex;
    align-items: center;
    gap: 18px;
    font-size: clamp(24px, 2.1vw, 32px);
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -.04em;
  }
  .featured-subtitle { color: #fff; font-size: 15px; line-height: 1.4; }
  .featured-arrow { transition: transform .2s; }
  .featured-link:hover .featured-arrow, .featured-link:focus-visible .featured-arrow { transform: translateX(6px); }
  .featured-link:hover .featured-title>span:first-child { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .links-panel {
    background: var(--site-panel);
    color: var(--site-ink);
    padding: 95px 10% 95px 0;
    display: flex;
    align-items: center;
  }
  .link-sheet {
    position: relative;
    width: calc(100% - 20px);
    background: var(--site-card);
    padding: 30px 32px 18px;
    transform: translateX(-30px) rotate(-4deg);
    box-shadow: 8px 8px 0 var(--site-shadow);
  }
  .sheet-heading {
    border-bottom: 1px solid currentColor;
    padding-bottom: 22px;
  }
  h2 {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -.03em;
  }
  .profile-link {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 103px;
    padding: 22px 0;
    border-bottom: 1px solid var(--site-rule);
  }
  .profile-link:last-child { border-bottom: 0; }
  .link-copy { display: flex; flex-direction: column; gap: 8px; }
  .link-copy strong {
    font-size: clamp(27px, 2.4vw, 39px);
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -.045em;
  }
  .link-copy>span { font-size: 15px; }
  .link-arrow { margin-left: auto; font-size: 29px; transition: transform .2s; }
  .profile-link:hover .link-arrow { transform: translate(4px,-4px); }
  .profile-link:hover strong { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .seal {
    width: 88px;
    height: 88px;
    border: 1px solid var(--blue);
    border-radius: 50%;
    background: var(--lemon);
    color: var(--blue);
    font-size: 42px;
    font-weight: 700;
    letter-spacing: -.12em;
    display: grid;
    place-items: center;
    padding-right: 5px;
    position: absolute;
    top: -49px;
    right: -12px;
    transform: rotate(16deg);
    pointer-events: none;
  }
  @media (min-width: 1900px) {
    .link-sheet { max-width: 700px; }
  }
  @media (max-width: 1100px) and (min-width: 701px) {
    h1 { font-size: 10.4vw; }
    .links-panel { padding-right: 8%; }
    .link-sheet { width: 100%; padding: 26px 24px 14px; transform: translateX(-20px) rotate(-4deg); }
    .link-copy strong { font-size: 30px; }
    .seal { width: 76px; height: 76px; font-size: 37px; top: -42px; }
  }
  @media (max-width: 700px) {
    .id-page { grid-template-columns: 1fr; }
    .page-settings { top: 12px; right: 7%; color: var(--site-text); --theme-toggle-accent: var(--site-accent); }
    .identity { padding: 75px 7% 40px; min-height: 280px; gap: 28px; }
    h1 { font-size: 17vw; line-height: .96; }
    .links-panel { padding: 70px 10% 60px; }
    .link-sheet { width: 100%; padding: 26px 26px 12px; transform: rotate(-3deg); box-shadow: 8px 8px 0 var(--site-shadow); }
    .profile-link { min-height: 98px; padding: 20px 0; }
    .link-copy strong { font-size: 32px; }
    .link-copy>span { font-size: 14px; }
    .link-arrow { font-size: 27px; }
    .seal { width: 76px; height: 76px; font-size: 37px; top: -44px; right: -9px; }
  }
  @media (max-width: 370px) {
    .identity { min-height: 245px; }
    .link-sheet { padding-left: 21px; padding-right: 21px; }
    .link-copy strong { font-size: 29px; }
  }
</style>
