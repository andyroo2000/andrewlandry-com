---
import Base from '../layouts/Base.astro';
import { designs } from '../data/designs';
---
<Base title="Six directions — Andrew Landry" theme="design-index">
  <main id="main">
    <header><a href="/" class="wordmark">Andrew Landry<span>*</span></a><span class="mono">A new place on the internet / 2026</span></header>
    <section class="intro"><div><p class="mono">Design explorations</p><h1>One person.<br /><span>Six perspectives.</span></h1></div><p>Photographs. Music. A few things worth keeping.<br />Explore six different ways of putting them together.</p></section>
    <div class="directions">
      {designs.map(d => <a class="direction" href={`/designs/${d.slug}/`} style={`--accent:${d.color}`}>
        <div class="preview"><iframe src={`/designs/${d.slug}/`} title={`${d.name} preview`} loading="lazy" tabindex="-1" aria-hidden="true" sandbox=""></iframe><span class="open">Explore direction ↗</span></div>
        <div class="label"><span class="number mono">{d.number}</span><div><h2>{d.name}</h2><p>{d.tone}</p></div><span class="arrow">↗</span></div>
      </a>)}
    </div>
    <footer><span>Six independent directions. Your photographs, in a new light.</span><span class="mono">Andrew Landry · Design studies</span></footer>
  </main>
</Base>
<style>
main{max-width:1660px;margin:auto;padding:0 5%}header{display:flex;align-items:center;justify-content:space-between;padding:35px 0;border-bottom:1px solid #ddd}.wordmark{font-size:23px;font-weight:600;letter-spacing:-1px}.wordmark span{font-size:12px;vertical-align:top;margin-left:4px}.intro{display:flex;align-items:end;justify-content:space-between;padding:80px 0 60px;gap:30px}.intro .mono{margin-bottom:22px;color:#777}h1{font-size:clamp(45px,5.5vw,86px);font-weight:500;letter-spacing:-.065em;line-height:1.03}h1 span{color:#929292}.intro>p{font-size:16px;line-height:1.7;color:#666;padding-bottom:6px}.directions{display:grid;grid-template-columns:1fr 1fr;gap:55px 28px}.preview{aspect-ratio:1.55;background:#eaeaea;overflow:hidden;position:relative;border:1px solid #ddd}.preview iframe{border:0;width:400%;height:400%;transform:scale(.25);transform-origin:0 0;pointer-events:none}.open{position:absolute;bottom:18px;right:18px;padding:10px 17px;border-radius:30px;background:#fff;color:#111;font-size:13px;opacity:0;transform:translateY(8px);transition:.2s}.direction:hover .open,.direction:focus-visible .open{opacity:1;transform:none}.label{display:flex;align-items:center;gap:19px;padding:20px 0}.number{width:39px;height:39px;display:grid;place-items:center;border:1px solid #ccc;border-radius:50%}.label h2{font-size:23px;letter-spacing:-.7px;font-weight:500}.label p{font-size:13px;color:#777;margin-top:5px}.arrow{margin-left:auto;font-size:25px}.direction:hover .number{background:var(--accent);border-color:var(--accent);color:white}footer{display:flex;justify-content:space-between;gap:20px;border-top:1px solid #ddd;margin-top:55px;padding:30px 0 40px;font-size:13px;color:#777}@media(max-width:700px){header>.mono{display:none}.intro{display:block;padding:50px 0 35px}.intro>p{margin-top:24px}.directions{grid-template-columns:1fr;gap:20px}.label h2{font-size:22px}footer{display:block;line-height:1.8}footer .mono{display:block;margin-top:10px}}
</style>
