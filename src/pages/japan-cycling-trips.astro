---
import TripMap from '../components/TripMap.astro';
import ArrowUpRight from '../components/ArrowUpRight.astro';
import ThemeHead from '../components/ThemeHead.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { env } from 'node:process';
const localPreview = import.meta.env.DEV && Boolean(env.JAPAN_TRIP_MEDIA_DIR);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <ThemeHead />
    <meta name="description" content="Two cycling trips through Hokkaido, Japan. Films by Andrew Landry." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>Japan Cycling Trips — Andrew Landry</title>
  </head>
  <body>
    <main class="trip-page" tabindex="-1" data-trip-page data-local-preview={localPreview}>
      <TripMap />
      <div class="title-wash" aria-hidden="true"></div>
      <a href="/" class="home" aria-label="Andrew Landry home"><span class="desktop-home">AL<span aria-hidden="true"><ArrowUpRight /></span></span><span class="mobile-home"><span aria-hidden="true">←</span> Home</span></a>
      <h1 aria-label="Japan Cycling Trips">Japan<br /><span>Cycling</span><br />Trips<span class="period">.</span></h1>
      <div class="trip-settings">
        <div class="trip-theme"><ThemeToggle /></div>
        <nav class="trip-switcher" aria-label="Choose a cycling trip">
          <button type="button" data-year="2025" aria-pressed="false">2025</button>
          <button type="button" data-year="2026" aria-pressed="true">2026</button>
        </nav>
      </div>
      <section class="film" aria-label="Japan cycling trip video">
        <div class="film-surface">
          {localPreview ? (
            <video
              data-local-video
              controls
              playsinline
              muted
              preload="metadata"
              poster="/images/japan-cycling-2026.webp"
              src="/__trip-media/2026.mp4"
              aria-label="Hokkaido cycling trip 2026"
            >Your browser does not support video playback.</video>
          ) : (
            <iframe
              id="trip-youtube"
              title="Hokkaido cycling trip 2026"
              src="https://www.youtube.com/embed/K6CPy63peaE?enablejsapi=1&playsinline=1&rel=0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          )}
        </div>
      </section>
      <div class="place" data-place hidden>
        <button type="button" class="item-button" data-previous-item aria-label="Previous story" aria-keyshortcuts="ArrowLeft" title="Previous story (←)" disabled><span aria-hidden="true">‹</span></button>
        <span class="place-details" aria-live="polite">
        <span class="trip-time"><span class="trip-day-row"><span class="trip-day" data-trip-day></span><span class="trip-distance" data-trip-distance></span></span><time data-trip-date></time></span>
        <span class="current-place" data-place-name>Sapporo</span>
        </span>
        <button type="button" class="item-button" data-next-item aria-label="Next story" aria-keyshortcuts="ArrowRight" title="Next story (→)" disabled><span aria-hidden="true">›</span></button>
      </div>
      <div class="map-credit"><a href="https://www.openstreetmap.org/copyright">© OpenStreetMap contributors</a><span> · </span><a href="/data/japan-map-SOURCES.txt">Map data</a></div>
      <a class="video-fallback" data-video-fallback href="https://youtu.be/K6CPy63peaE" hidden>Open video on YouTube <ArrowUpRight /></a>
      <noscript><style>.trip-switcher { display: none; }</style></noscript>
    </main>
    <script>
      import '../scripts/japan-cycling';
    </script>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: var(--site-bg); font-family: 'Space Grotesk', sans-serif; }
  .trip-page { --blue: var(--site-bg); --lemon: #f2f76c; position: relative; isolation: isolate; height: 100svh; height: 100dvh; min-height: 480px; overflow: hidden; color: #fff; }
  .title-wash { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, var(--site-bg) 0%, color-mix(in srgb, var(--site-bg) 93%, transparent) 21%, transparent 48%); }
  a { color: inherit; text-decoration: none; }
  a, button { touch-action: manipulation; }
  a:focus-visible, button:focus-visible { outline: 3px solid currentColor; outline-offset: 6px; }
  .home { position: absolute; top: 35px; left: 4vw; font-size: 23px; letter-spacing: -.1em; font-weight: 700; z-index: 3; }
  .home span { display: inline-block; margin-left: 12px; letter-spacing: 0; font-size: 19px; transition: transform .2s; }
  .home:hover .desktop-home>span { transform: translate(3px, -3px); }
  .home>.desktop-home { margin-left: 0; font-size: inherit; letter-spacing: inherit; }
  .home>.mobile-home { display: none; }
  h1 { position: absolute; left: 4vw; top: 50%; transform: translateY(-52%); margin: 0; font-size: clamp(58px, 6.7vw, 132px); line-height: .96; letter-spacing: -.065em; font-weight: 600; z-index: 2; }
  h1 span { color: var(--lemon); }
  h1 .period { color: #fff; }
  .trip-settings { position: absolute; top: 30px; right: 3.2vw; z-index: 5; display: flex; align-items: center; gap: 20px; }
  .trip-theme { background: var(--site-bg); padding-inline: 10px; }
  .trip-switcher { display: flex; background: var(--site-card); color: var(--site-ink); padding: 5px; transform: rotate(-3deg); box-shadow: 5px 5px 0 var(--site-shadow); }
  .trip-switcher button { border: 0; border-radius: 0; padding: 12px 18px; background: transparent; color: inherit; font: 500 20px 'Space Grotesk', sans-serif; cursor: pointer; }
  .trip-switcher button[aria-pressed='true'] { color: var(--blue); background: var(--lemon); }
  .trip-switcher button:hover { text-decoration: underline; text-underline-offset: 5px; }
  .film { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); height: calc(100% - 110px); max-width: 40vw; aspect-ratio: 9 / 16; z-index: 3; }
  .film::before { content: ''; position: absolute; inset: -7px; background: var(--site-card); box-shadow: 10px 10px 0 var(--site-shadow); }
  .film-surface { height: 100%; width: 100%; position: relative; background: #000; }
  video, iframe { display: block; border: 0; width: 100%; height: 100%; object-fit: contain; background: #000; }
  .place { position: absolute; bottom: 36px; right: 3.2vw; z-index: 4; padding: 8px; background: var(--site-card); color: var(--site-ink); transform: rotate(-3deg); font-size: clamp(16px, 1.55vw, 22px); font-weight: 500; letter-spacing: -.04em; box-shadow: 5px 5px 0 var(--site-shadow); display: flex; align-items: center; gap: 4px; max-width: calc(32vw - 20px); }
  .place-details { display: flex; align-items: center; gap: 12px; min-width: 0; padding: 4px; }
  .item-button { flex: 0 0 36px; align-self: stretch; min-height: 44px; border: 0; padding: 0; background: transparent; color: var(--site-ink); font: 400 30px/1 'Space Grotesk', sans-serif; cursor: pointer; }
  .item-button:hover:not(:disabled) { background: var(--lemon); color: #101835; }
  .item-button:disabled { opacity: .25; cursor: default; }
  .place[hidden] { display: none; }
  .trip-time { display: grid; gap: 3px; flex-shrink: 0; padding-right: 14px; border-right: 1px solid var(--site-rule); font-size: 12px; letter-spacing: 0; }
  .trip-day-row { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 8px; row-gap: 2px; }
  .trip-distance { white-space: nowrap; font-size: 11px; font-weight: 500; }
  .trip-day { white-space: nowrap; font-size: 14px; font-weight: 600; }
  .current-place { min-width: 0; overflow-wrap: anywhere; }
  .map-credit { position: absolute; left: 4vw; bottom: 15px; z-index: 2; font-size: 10px; color: #fff; }
  .map-credit a:hover { text-decoration: underline; }
  .video-fallback { position: absolute; left: 50%; bottom: 12px; transform: translateX(-50%); z-index: 6; background: var(--site-card); color: var(--site-ink); padding: 10px 16px; white-space: nowrap; }
  ::selection { background: var(--lemon); color: var(--blue); }
  @media (min-width: 901px) and (max-width: 1200px) {
    .place { max-width: calc(26.8vw - 26px); padding: 6px; }
    .place-details { flex-direction: column; align-items: flex-start; gap: 5px; }
    .trip-time { border-right: 0; padding-right: 0; }
    .item-button { flex-basis: 28px; }
  }
  @media (max-width: 900px), (hover: none) {
    .trip-page {
      min-height: 360px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: auto minmax(0, 1fr) auto;
      padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
      background: var(--blue);
    }
    .title-wash, .map-credit { display: none; }
    .home { position: static; grid-area: 1 / 1; align-self: center; justify-self: start; margin-left: 16px; min-height: 44px; display: flex; align-items: center; font-size: 16px; font-weight: 500; letter-spacing: 0; }
    .home>.desktop-home { display: none; }
    .home>.mobile-home { display: inline; margin: 0; font-size: inherit; transform: none; }
    .mobile-home span { margin: 0 6px 0 0; font-size: 22px; transform: none; }
    h1 { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .film { position: relative; inset: auto; grid-area: 2 / 1 / 3 / -1; transform: none; width: 100%; height: 100%; min-height: 0; max-width: none; aspect-ratio: auto; container-type: size; }
    .film::before { display: none; }
    .film-surface { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: min(100cqw, calc(100cqh * 9 / 16)); height: auto; aspect-ratio: 9 / 16; }
    .trip-settings { position: static; grid-area: 1 / 2; justify-self: end; margin: 12px 16px 12px 0; gap: 12px; }
    .trip-theme { padding-inline: 0; }
    .trip-switcher { transform: none; padding: 3px; box-shadow: none; }
    .trip-switcher button { font-size: 16px; min-height: 44px; padding: 8px 14px; }
    .place { position: static; grid-area: 3 / 1 / 4 / -1; justify-self: center; width: calc(100% - 32px); max-width: 480px; margin: 18px 16px; padding: 6px; gap: 0; transform: rotate(-2deg); font-size: 18px; box-shadow: 4px 4px 0 var(--site-shadow); }
    .place-details { flex: 1; flex-direction: row; gap: 10px; padding: 2px 4px; }
    .trip-time { padding-right: 10px; border-right: 1px solid var(--site-rule); font-size: 11px; }
    .trip-day-row { flex-direction: column; gap: 2px; }
    .trip-distance { font-size: 10px; }
    .item-button { flex-basis: 44px; }
    .video-fallback { top: 50%; bottom: auto; transform: translate(-50%, -50%); max-width: calc(100% - 32px); white-space: normal; text-align: center; }
  }
  @media (max-width: 370px) {
    .trip-settings { gap: 8px; margin-right: 12px; }
    .trip-switcher button { padding-inline: 10px; }
    .place { font-size: 16px; width: calc(100% - 24px); margin-inline: 12px; padding: 4px; }
    .place-details { gap: 8px; padding-inline: 2px; }
    .trip-time { padding-right: 8px; }
  }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition: none !important; } }
</style>
